# NextAuth.js Credentials Provider
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# JSON array of users. Store bcrypt hashes, never plaintext passwords.
AUTH_USERS_JSON='[{"id":"admin-1","name":"Admin ASSAR","email":"admin@assar.org","passwordHash":"$2b$10$REPLACE_WITH_BCRYPT_HASH","accessLevel":"paid","isAdmin":true}]'
